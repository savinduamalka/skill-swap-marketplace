# Socket Server Environment Variables

# Shared secret for authenticating socket connections and internal API calls
# MUST match the SOCKET_SECRET in the Next.js app's .env
SOCKET_SECRET=

# PostgreSQL connection string (same database as the Next.js app)
DATABASE_URL=

# Port the socket server listens on (default: 4000)
PORT=4000

# Next.js app URL (used for CORS origin and internal email notification calls)
NEXTJS_URL=http://localhost:3000

# Redis URL for Socket.IO adapter, presence tracking, and rate limiting
REDIS_URL=redis://localhost:6379
